# Slack — create a Slack app at api.slack.com/apps, add slash command + scopes (channels:history, chat:write, commands)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# PagerDuty — OPTIONAL. If not set, this data source is skipped.
# Free plan available at pagerduty.com (up to 5 responders). API key from User Profile → API Access.
PAGERDUTY_API_KEY=

# GitHub — Personal Access Token with repo:read scope (github.com → Settings → Developer settings → PATs)
GITHUB_TOKEN=ghp_your_token_here
# Comma-separated list of repos to query for commits and deployments
GITHUB_REPOS=your-org/your-repo

# Groq — free tier at console.groq.com (14,400 req/day, 6,000 tokens/min)
GROQ_API_KEY=gsk_your_key_here
# Groq model ID — check current supported models at console.groq.com/docs/models
GROQ_MODEL=qwen/qwen3.6-27b

# Access request system
# Resend — free tier at resend.com (3,000 emails/month). Create an account, verify your email,
# copy the API key from resend.com/api-keys.
RESEND_API_KEY=re_your_key_here
# Email address that receives access request notifications (your Gmail)
NOTIFY_EMAIL=buildingai.in@gmail.com
# Public URL of this app (used in email links)
NEXT_PUBLIC_APP_URL=https://postmortem.buildingai.in

# Admin dashboard — set this to any long random string (e.g. openssl rand -hex 32)
ADMIN_SECRET=your-long-random-secret-here

# Upstash Redis — create a free Redis database at upstash.com, then copy these values
# from the database dashboard → REST API section.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
